<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Polaris LAN</title>
    <style>
        :root {
            --bg: #0e1118;
            --bg-glow: rgba(99, 120, 255, 0.12);
            --card: #161b26;
            --card-hover: #1c2230;
            --border: #232a3a;
            --text: #e8ebf2;
            --muted: #7d879c;
            --accent: #7c8cff;
            --up: #3ddc84;
            --down: #ff5c6c;
            --pending: #596176;
            --shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
        }
        @media (prefers-color-scheme: light) {
            :root {
                --bg: #f4f6fb;
                --bg-glow: rgba(99, 120, 255, 0.10);
                --card: #ffffff;
                --card-hover: #f8f9ff;
                --border: #e2e6f0;
                --text: #1b2130;
                --muted: #6b7489;
                --accent: #4f5fe0;
                --up: #1fae62;
                --down: #e03e50;
                --pending: #a3abbd;
                --shadow: 0 8px 24px rgba(30, 40, 80, 0.12);
            }
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            padding: 32px clamp(16px, 4vw, 48px) 48px;
            font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Helvetica, Arial, sans-serif;
            background: radial-gradient(900px 400px at 15% -10%, var(--bg-glow), transparent), var(--bg);
            background-attachment: fixed;
            color: var(--text);
            -webkit-font-smoothing: antialiased;
        }
        .wrap { max-width: 1400px; margin: 0 auto; }
        .header {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            justify-content: space-between;
            align-items: center;
        }
        h1 {
            margin: 0;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.02em;
        }
        h1 span { color: var(--accent); }
        .summary {
            margin-top: 4px;
            font-size: 14px;
            color: var(--muted);
        }
        .summary b { color: var(--text); font-weight: 600; }
        .summary .bad { color: var(--down); }
        .controls { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        .search {
            position: relative;
        }
        .search input {
            width: 260px;
            max-width: 100%;
            padding: 10px 40px 10px 14px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: var(--card);
            color: var(--text);
            font: inherit;
            font-size: 14px;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .search input::placeholder { color: var(--muted); }
        .search input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
        }
        .search kbd {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            font: 12px ui-monospace, SFMono-Regular, Menlo, monospace;
            color: var(--muted);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 1px 6px;
            pointer-events: none;
        }
        button {
            padding: 10px 16px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: var(--card);
            color: var(--text);
            font: inherit;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.15s, border-color 0.15s;
        }
        button:hover { background: var(--card-hover); border-color: var(--accent); }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 14px;
            margin-top: 28px;
        }
        .box {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            color: var(--text);
            text-decoration: none;
            min-width: 0;
            transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .box:hover {
            background: var(--card-hover);
            border-color: var(--accent);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }
        .box:active { transform: translateY(0); }
        .box:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        .box.hidden { display: none; }
        .avatar {
            flex: none;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-weight: 700;
            font-size: 17px;
            color: #fff;
            background: hsl(var(--hue), 55%, 48%);
            position: relative;
            overflow: hidden;
            transition: background 0.2s;
        }
        .avatar img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            padding: 7px;
            object-fit: contain;
            opacity: 0;
            transition: opacity 0.2s;
        }
        .avatar.has-icon { background: color-mix(in srgb, var(--text) 10%, var(--card)); }
        .avatar.has-icon span { visibility: hidden; }
        .avatar.has-icon img { opacity: 1; }
        .info { min-width: 0; flex: 1; }
        .title {
            font-size: 15px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .url {
            margin-top: 2px;
            font-size: 13px;
            color: var(--muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .status {
            flex: none;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 600;
            color: var(--down);
        }
        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--pending);
        }
        .status.loading .dot { animation: pulse 1.2s ease-in-out infinite; }
        .status.green .dot {
            background: var(--up);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--up) 22%, transparent);
        }
        .status.red .dot {
            background: var(--down);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--down) 22%, transparent);
        }
        @keyframes pulse { 50% { opacity: 0.35; } }
        .empty {
            display: none;
            margin-top: 48px;
            text-align: center;
            color: var(--muted);
        }
        @media (max-width: 520px) {
            .search, .search input { width: 100%; }
            .controls { width: 100%; }
        }
    </style>
</head>
<body>
<div class="wrap">
    <div class="header">
        <div>
            <h1><span>✦</span> Polaris LAN</h1>
            <div class="summary" id="summary">Checking services…</div>
        </div>
        <div class="controls">
            <div class="search">
                <input id="search" type="search" placeholder="Filter services" autocomplete="off" aria-label="Filter services">
                <kbd>/</kbd>
            </div>
            <button onclick="refresh()">Refresh</button>
        </div>
    </div>
    <div class="grid" id="services">
        {% for service in services %}
        <a href="{{ service.url }}" class="box" data-name="{{ service.name }}" data-search="{{ (service.name ~ ' ' ~ service.display_url)|lower }}" rel="noreferrer">
            <div class="avatar" data-label="{{ service.name }}">
                <span>{{ service.name[0]|upper }}</span>
                <img src="/icon/{{ service.name|urlencode }}" alt="" loading="lazy">
            </div>
            <div class="info">
                <div class="title">{{ service.name }}</div>
                <div class="url">{{ service.display_url }}</div>
            </div>
            <div class="status loading" title="Loading..."><span class="code"></span><span class="dot"></span></div>
        </a>
        {% endfor %}
    </div>
    <div class="empty" id="empty">No services match your filter.</div>
</div>

<script>
    const total = {{ services|length }};
    let pending = 0;

    function hueFor(text) {
        let h = 0;
        for (const c of text) h = (h * 31 + c.charCodeAt(0)) % 360;
        return h;
    }

    // Make a near-white background transparent by flood-filling inward from the
    // edges, so white details inside the icon itself are left alone.
    function stripWhiteBackground(img) {
        const size = 96;
        try {
            const canvas = document.createElement("canvas");
            canvas.width = canvas.height = size;
            const ctx = canvas.getContext("2d", { willReadFrequently: true });
            ctx.drawImage(img, 0, 0, size, size);
            const data = ctx.getImageData(0, 0, size, size);
            const px = data.data;
            const isWhite = i => px[i + 3] > 200 && px[i] > 235 && px[i + 1] > 235 && px[i + 2] > 235;
            const at = (x, y) => (y * size + x) * 4;

            const corners = [[0, 0], [size - 1, 0], [0, size - 1], [size - 1, size - 1]];
            if (!corners.every(([x, y]) => isWhite(at(x, y)))) return;

            const seen = new Uint8Array(size * size);
            const stack = [];
            for (let i = 0; i < size; i++) {
                stack.push([i, 0], [i, size - 1], [0, i], [size - 1, i]);
            }
            while (stack.length) {
                const [x, y] = stack.pop();
                if (x < 0 || y < 0 || x >= size || y >= size || seen[y * size + x]) continue;
                seen[y * size + x] = 1;
                const i = at(x, y);
                if (!isWhite(i)) continue;
                px[i + 3] = 0;
                stack.push([x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]);
            }
            ctx.putImageData(data, 0, 0);
            img.src = canvas.toDataURL();
        } catch (e) {
            // canvas unavailable or tainted: keep the original icon
        }
    }

    function setStatus(element, status) {
        const code = element.querySelector(".code");
        element.classList.remove("loading", "green", "red");
        if (status.up) {
            element.classList.add("green");
            element.title = `UP | Status Code: ${status.status_code}\n${status.url}`;
            code.textContent = "";
        } else {
            element.classList.add("red");
            element.title = `DOWN | Status Code: ${status.status_code}\n${status.url}`;
            code.textContent = status.status_code !== null ? `${status.status_code}` : "";
        }
        updateSummary();
    }

    function clearStatus(element) {
        element.classList.remove("green", "red");
        element.classList.add("loading");
        element.title = "Loading...";
        element.querySelector(".code").textContent = "";
    }

    function updateSummary() {
        const up = document.querySelectorAll(".status.green").length;
        const down = document.querySelectorAll(".status.red").length;
        const el = document.getElementById("summary");
        if (up + down < total) {
            el.textContent = `Checking services… ${up + down}/${total}`;
        } else if (down === 0) {
            el.innerHTML = `<b>${up}</b> services · all up`;
        } else {
            el.innerHTML = `<b>${up}</b> up · <span class="bad"><b>${down}</b> down</span>`;
        }
    }

    function getStatuses() {
        for (const link of document.querySelectorAll("#services a")) {
            const status = link.querySelector(".status");
            if (inIframe()) link.target = "_blank";
            fetch(`/status/${encodeURIComponent(link.dataset.name)}`)
                .then(r => r.json())
                .then(s => setStatus(status, s))
                .catch(() => setStatus(status, { up: false, status_code: null, url: "" }));
        }
    }

    function refresh() {
        document.querySelectorAll(".status").forEach(clearStatus);
        updateSummary();
        getStatuses();
    }

    function inIframe() {
        try {
            return window.self !== window.top;
        } catch (e) {
            return true;
        }
    }

    const search = document.getElementById("search");
    search.addEventListener("input", () => {
        const q = search.value.trim().toLowerCase();
        let shown = 0;
        for (const box of document.querySelectorAll("#services a")) {
            const match = box.dataset.search.includes(q);
            box.classList.toggle("hidden", !match);
            if (match) shown++;
        }
        document.getElementById("empty").style.display = shown ? "none" : "block";
    });
    search.addEventListener("keydown", e => {
        if (e.key === "Enter") {
            const first = document.querySelector("#services a:not(.hidden)");
            if (first) first.click();
        } else if (e.key === "Escape") {
            search.value = "";
            search.dispatchEvent(new Event("input"));
            search.blur();
        }
    });
    document.addEventListener("keydown", e => {
        if (e.key === "/" && document.activeElement !== search) {
            e.preventDefault();
            search.focus();
        }
    });

    document.querySelectorAll(".avatar").forEach(a => {
        a.style.setProperty("--hue", hueFor(a.dataset.label));
        const img = a.querySelector("img");
        const show = () => {
            if (img.naturalWidth === 0) return;
            stripWhiteBackground(img);
            a.classList.add("has-icon");
        };
        if (img.complete) show();
        else img.addEventListener("load", show);
        img.addEventListener("error", () => img.remove());
    });

    getStatuses();
</script>
</body>
</html>
