# Woodpecker address as reachable by users and used for the GitHub OAuth callback
WOODPECKER_HOST=http://woodpecker.lan.nathancj.com

# GitHub username(s) allowed to sign in as admin (registration is otherwise closed)
WOODPECKER_ADMIN=nathan815

# Public base URL GitHub uses to deliver webhooks (cloudflared tunnel -> nginx-public)
WOODPECKER_WEBHOOK_HOST=https://ci-hooks.nathancj.com

# GitHub OAuth App credentials: https://github.com/settings/developers
# Homepage URL:               http://woodpecker.lan.nathancj.com
# Authorization callback URL: http://woodpecker.lan.nathancj.com/authorize
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# Shared secret between server and agent(s). Generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=

# External port to expose the web UI/API on
# NOTE: 8000 is taken on pi01 by nginx-proxy's nginx-public container, hence 8001
WOODPECKER_PORT=8001

# Max concurrent pipeline workflows this agent will run
WOODPECKER_MAX_WORKFLOWS=2
