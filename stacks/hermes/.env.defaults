# Pin to a specific X.Y.Z once you're happy - Hermes is 0.x and moves fast
HERMES_VERSION=stable

# Bearer key for the OpenAI-compatible API (:8642). The iOS app / Open WebUI use this.
# Generate with: openssl rand -hex 32
HERMES_API_KEY=

# Dashboard (:9119) basic auth. LAN-only - do not expose publicly.
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=
# Keeps sessions valid across restarts. Generate with: openssl rand -hex 32
HERMES_DASHBOARD_SECRET=

# Model provider - set whichever you use (or run `docker compose run --rm hermes setup`)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
