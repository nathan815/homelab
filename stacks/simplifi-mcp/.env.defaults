# Runtime data root on the host, outside the stack folder (docs/appdata-migration.md)
APPDATA_DIR=/opt/appdata

SIMPLIFI_MCP_PORT=8787

# Secrets: set in .env (or Komodo secret variables), not here
OAUTH_JWT_SECRET=
ALLOWED_EMAIL=
# Public URL via the Cloudflare tunnel, e.g. https://simplifi.example.com
PUBLIC_BASE_URL=
