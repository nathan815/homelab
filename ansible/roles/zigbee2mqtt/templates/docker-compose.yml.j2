---
version: '2'

name: zigbee2mqtt

services:
    zigbee2mqtt:
        image: koenkk/zigbee2mqtt:2.14.2@sha256:addbfb08fcef2e4477de1535636118241e10d13e898fbe4d9faba8a4d7396311
        container_name: zigbee2mqtt
        restart: always
        devices:
            - {{ zigbee_usb_device_path }}:/dev/ttyUSB0
        ports:
            - {{ zigbee_ui_port }}:8080
        volumes:
            - {{ zigbee_data_folder }}:/app/data
            - /run/udev:/run/udev:ro
        environment:
            - TZ=America/New_York
