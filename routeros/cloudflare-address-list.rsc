# Cloudflare IPv4 ranges - generated by update-cloudflare-list.sh from https://www.cloudflare.com/ips-v4
# Used by the NAT rule that forwards WAN port 80 to nginx-public (src-address-list=cloudflare).
/ip firewall address-list remove [find list=cloudflare]
/ip firewall address-list add list=cloudflare address=173.245.48.0/20 comment=cloudflare
/ip firewall address-list add list=cloudflare address=103.21.244.0/22 comment=cloudflare
/ip firewall address-list add list=cloudflare address=103.22.200.0/22 comment=cloudflare
/ip firewall address-list add list=cloudflare address=103.31.4.0/22 comment=cloudflare
/ip firewall address-list add list=cloudflare address=141.101.64.0/18 comment=cloudflare
/ip firewall address-list add list=cloudflare address=108.162.192.0/18 comment=cloudflare
/ip firewall address-list add list=cloudflare address=190.93.240.0/20 comment=cloudflare
/ip firewall address-list add list=cloudflare address=188.114.96.0/20 comment=cloudflare
/ip firewall address-list add list=cloudflare address=197.234.240.0/22 comment=cloudflare
/ip firewall address-list add list=cloudflare address=198.41.128.0/17 comment=cloudflare
/ip firewall address-list add list=cloudflare address=162.158.0.0/15 comment=cloudflare
/ip firewall address-list add list=cloudflare address=104.16.0.0/13 comment=cloudflare
/ip firewall address-list add list=cloudflare address=104.24.0.0/14 comment=cloudflare
/ip firewall address-list add list=cloudflare address=172.64.0.0/13 comment=cloudflare
